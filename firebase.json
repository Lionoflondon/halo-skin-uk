{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".firebaserc",
      ".git/**",
      ".gitignore",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**",
      "**/*.md",
      "**/package.json",
      "**/package-lock.json",
      "functions/**",
      "server/**",
      "test/**",
      "assets/halo-hero.jpg",
      "assets/halo-hero-sharp.webp",
      "assets/halo-flatlay.jpg",
      "assets/halo-trio-botanical.jpg",
      "assets/halo-pink-botanical.jpg",
      "assets/halo-lifestyle.jpg",
      "assets/halo-trio-blue.jpg",
      "assets/halo-trio-warm.jpg",
      "assets/halo-model-blue.jpg"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|webp|avif)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600,must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/api/createCheckoutSession", "function": { "functionId": "createCheckoutSession", "region": "europe-west2" } },
      { "source": "/api/stripeWebhook", "function": { "functionId": "stripeWebhook", "region": "europe-west2" } },
      { "source": "/api/getCheckoutStatus", "function": { "functionId": "getCheckoutStatus", "region": "europe-west2" } },
      { "source": "/api/customerOrders", "function": { "functionId": "customerOrders", "region": "europe-west2" } },
      { "source": "/api/rothLinkStart", "function": { "functionId": "rothLinkStart", "region": "europe-west2" } },
      { "source": "/api/rothWallet", "function": { "functionId": "rothWallet", "region": "europe-west2" } },
      { "source": "/api/createRothOrder", "function": { "functionId": "createRothOrder", "region": "europe-west2" } },
      { "source": "/api/requestHaloRothRefund", "function": { "functionId": "requestHaloRothRefund", "region": "europe-west2" } },
      { "source": "/api/rothIssueReward", "function": { "functionId": "rothIssueReward", "region": "europe-west2" } },
      { "source": "/api/rothSettlements", "function": { "functionId": "rothSettlements", "region": "europe-west2" } },
      { "source": "/api/adminOrders", "function": { "functionId": "adminOrders", "region": "europe-west2" } },
      { "source": "/api/adminFinancialReport", "function": { "functionId": "adminFinancialReport", "region": "europe-west2" } },
      { "source": "/api/adminReconcilePendingFinancialEntries", "function": { "functionId": "adminReconcilePendingFinancialEntries", "region": "europe-west2" } },
      { "source": "/api/updateHaloOrder", "function": { "functionId": "updateHaloOrder", "region": "europe-west2" } },
      { "source": "/api/requestHaloRefund", "function": { "functionId": "requestHaloRefund", "region": "europe-west2" } },
      { "source": "/api/setHaloStockCount", "function": { "functionId": "setHaloStockCount", "region": "europe-west2" } }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Halo",
        "supportEmail": "ayojason600@gmail.com"
      }
    }
  },
  "functions": [{ "source": "functions", "codebase": "halo", "runtime": "nodejs22" }]
}
